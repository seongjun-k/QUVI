#!/bin/bash
# ------------------------------------------------------------------
# Cyclo Intelligence One-Click CLI Launcher
# ------------------------------------------------------------------
# Usage:
#   cyclo [start]       Start Zenoh daemon + Cyclo Intelligence + LeRobot policy + open UI
#   cyclo stop          Stop Cyclo Intelligence & LeRobot containers
#   cyclo stop-all      Stop all Cyclo stack (including Zenoh & Cyclo Manager)
#   cyclo status        Check status of all Cyclo & robot containers and services
#   cyclo ui            Open Cyclo Web UI in default browser (http://localhost:7080)
#   cyclo logs          View live logs of Cyclo containers
#   cyclo enter [name]  Enter interactive bash in cyclo_intelligence or lerobot_server
# ------------------------------------------------------------------

set -e

CYCLO_DIR="/home/ksj/cyclo_intelligence"
CYCLO_UI_URL="http://localhost:7080"
CYCLO_MANAGER_URL="http://localhost:3000"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

is_container_running() {
    docker ps --format '{{.Names}}' | grep -q "^$1$"
}

start_zenoh_if_needed() {
    if is_container_running "zenoh_daemon"; then
        echo -e "${GREEN}✔${NC} Zenoh Router가 이미 실행 중입니다 (:7447)"
    else
        echo -e "${YELLOW}⚡${NC} Zenoh Router 시작 중 (cyclo-manager up)..."
        /home/ksj/.local/bin/cyclo-manager up
        sleep 2
    fi
}

open_browser() {
    local url="${1:-$CYCLO_UI_URL}"
    export DISPLAY="${DISPLAY:-:0}"
    echo -e "${BLUE}🌐 브라우저를 엽니다: ${url}${NC}"

    # 터미널 종료 시 함께 종료되지 않도록 setsid / nohup 으로 분리 실행
    if command -v google-chrome >/dev/null 2>&1; then
        setsid nohup google-chrome "$url" >/dev/null 2>&1 &
    elif command -v google-chrome-stable >/dev/null 2>&1; then
        setsid nohup google-chrome-stable "$url" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        setsid nohup xdg-open "$url" >/dev/null 2>&1 &
    elif command -v gio >/dev/null 2>&1; then
        setsid nohup gio open "$url" >/dev/null 2>&1 &
    elif command -v firefox >/dev/null 2>&1; then
        setsid nohup firefox "$url" >/dev/null 2>&1 &
    else
        python3 -m webbrowser "$url" >/dev/null 2>&1 &
    fi
}

start_all() {
    local no_browser=0
    for arg in "$@"; do
        if [ "$arg" = "--no-browser" ] || [ "$arg" = "-n" ]; then
            no_browser=1
        fi
    done

    echo -e "${BLUE}=======================================${NC}"
    echo -e "${BLUE}     ROBOTIS Cyclo Intelligence 기동    ${NC}"
    echo -e "${BLUE}=======================================${NC}"

    # 이미 실행 중인 경우 중복 기동 방지
    if is_container_running "cyclo_intelligence" && is_container_running "lerobot_server"; then
        echo -e "${GREEN}✔ Cyclo Intelligence 및 정책 컨테이너가 이미 실행 중입니다.${NC}"
        for svc in orchestrator cyclo_data; do
            curl -s -X POST "http://localhost:7080/api/services/${svc}/start" >/dev/null 2>&1 || true
        done

        if [ "$no_browser" -eq 0 ]; then
            open_browser "$CYCLO_UI_URL"
        fi

        echo ""
        echo -e "${GREEN}이미 동작 중이므로 추가 기동 없이 브라우저를 열었습니다.${NC}"
        echo -e "창을 닫으려면 [Enter] 키를 누르세요 (3초 후 자동 종료)..."
        read -r -t 3 || true
        return 0
    fi

    # 1. Zenoh Daemon
    start_zenoh_if_needed

    # 2. Main cyclo_intelligence container
    echo -e "${YELLOW}⚡${NC} cyclo_intelligence 메인 컨테이너 시작 중..."
    (cd "$CYCLO_DIR" && ./docker/container.sh start)

    # 3. LeRobot policy container
    echo -e "${YELLOW}⚡${NC} lerobot_server 정책 컨테이너 시작 중..."
    (cd "$CYCLO_DIR" && GPU_ARCH=default ./docker/container.sh start-lerobot)

    # 4. Orchestrator & Cyclo Data services (rosbridge websocket, get_robot_types)
    echo -e "${YELLOW}⚡${NC} orchestrator 및 cyclo_data 서비스 기동 중..."
    for svc in orchestrator cyclo_data; do
        curl -s -X POST "http://localhost:7080/api/services/${svc}/start" >/dev/null 2>&1 || true
    done
    sleep 1

    echo ""
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}✔ Cyclo Intelligence 기동 완료!${NC}"
    echo -e "  - Cyclo UI:          ${BLUE}${CYCLO_UI_URL}${NC}"
    echo -e "  - Cyclo Manager UI:  ${BLUE}${CYCLO_MANAGER_URL}${NC}"
    echo -e "${GREEN}=======================================${NC}"

    if [ "$no_browser" -eq 0 ]; then
        open_browser "$CYCLO_UI_URL"
    fi

    echo ""
    echo -e "${GREEN}Cyclo 서비스가 백그라운드에서 실행 중입니다.${NC}"
    echo -e "터미널 창을 닫으려면 [Enter] 키를 누르세요 (10초 후 자동 종료)..."
    read -r -t 10 || true
}

safe_stop_container() {
    local name="$1"
    if is_container_running "$name"; then
        echo -e "  - ${name} 중지 중..."
        if ! docker stop -t 5 "$name" >/dev/null 2>&1; then
            local pid
            pid=$(docker inspect -f '{{.State.Pid}}' "$name" 2>/dev/null || echo 0)
            if [ -n "$pid" ] && [ "$pid" -gt 0 ]; then
                sudo -n kill -9 "$pid" >/dev/null 2>&1 || true
            fi
            docker stop "$name" >/dev/null 2>&1 || true
        fi
    fi
}

stop_cyclo() {
    echo -e "${BLUE}=======================================${NC}"
    echo -e "${BLUE}     ROBOTIS Cyclo Intelligence 종료    ${NC}"
    echo -e "${BLUE}=======================================${NC}"
    echo -e "${YELLOW}⚡ Cyclo 컨테이너들을 중지하는 중...${NC}"
    safe_stop_container "lerobot_server"
    safe_stop_container "cyclo_intelligence"
    echo ""
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}✔ Cyclo가 정상적으로 종료되었습니다.${NC}"
    echo -e "${GREEN}=======================================${NC}"
    echo -e "창을 닫으려면 [Enter] 키를 누르세요 (3초 후 자동 종료)..."
    read -r -t 3 || true
}

stop_all_stack() {
    echo -e "${YELLOW}Cyclo 전체 스택(Manager, Zenoh 포함)을 중지합니다...${NC}"
    (cd "$CYCLO_DIR" && docker compose -f docker/docker-compose.yml down)
    /home/ksj/.local/bin/cyclo-manager down || true
    echo -e "${GREEN}✔ 전체 스택 중지 완료${NC}"
}

show_status() {
    echo -e "${BLUE}=======================================${NC}"
    echo -e "${BLUE}        Cyclo 상태 대시보드            ${NC}"
    echo -e "${BLUE}=======================================${NC}"

    echo -e "\n[컨테이너 상태]"
    for c in "zenoh_daemon" "cyclo_intelligence" "lerobot_server" "open_manipulator" "cyclo_manager" "cyclo_manager_ui" "quvi-dev"; do
        if is_container_running "$c"; then
            echo -e "  ${GREEN}●${NC} $(printf '%-20s' "$c"): ${GREEN}실행 중${NC}"
        else
            echo -e "  ${RED}○${NC} $(printf '%-20s' "$c"): ${RED}중지됨${NC}"
        fi
    done

    echo -e "\n[접속 URL]"
    echo -e "  - Cyclo UI:          ${BLUE}${CYCLO_UI_URL}${NC}"
    echo -e "  - Cyclo Manager UI:  ${BLUE}${CYCLO_MANAGER_URL}${NC}"
    echo -e "  - Zenoh Router:      ${BLUE}localhost:7447${NC}"

    if is_container_running "cyclo_intelligence"; then
        echo -e "\n[Cyclo s6 서비스]"
        (cd "$CYCLO_DIR" && ./docker/container.sh status 2>/dev/null | grep -E "nginx|orchestrator|cyclo_data|supervisor|engine|main-runtime" || true)
    fi
}

open_ui() {
    open_browser "$CYCLO_UI_URL"
}

show_logs() {
    (cd "$CYCLO_DIR" && docker compose -f docker/docker-compose.yml logs -f)
}

enter_container() {
    local target="${1:-cyclo_intelligence}"
    if [ "$target" = "lerobot" ] || [ "$target" = "lerobot_server" ]; then
        (cd "$CYCLO_DIR" && ./docker/container.sh enter-lerobot)
    else
        (cd "$CYCLO_DIR" && ./docker/container.sh enter)
    fi
}

show_help() {
    cat << 'EOF'
사용법: cyclo [명령] [옵션]

명령:
  start [--no-browser]   Zenoh + Cyclo + LeRobot 컨테이너 기동 후 UI 열기 (기본값)
  stop                   Cyclo 및 LeRobot 컨테이너 일시 중지
  stop-all               Zenoh 및 Cyclo Manager까지 전체 스택 종료
  status                 실행 중인 Cyclo 컨테이너 및 서비스 요약 확인
  ui                     기본 브라우저에서 Cyclo UI (http://localhost:7080) 열기
  logs                   컨테이너 실시간 로그 확인 (Ctrl+C로 종료)
  enter [lerobot]        컨테이너 내부 bash 쉘 진입 (기본: cyclo_intelligence)
  help                   이 도움말 출력
EOF
}

cmd="${1:-start}"
shift || true

case "$cmd" in
    start|up)       start_all "$@" ;;
    stop|down)      stop_cyclo ;;
    stop-all)       stop_all_stack ;;
    status|ps)      show_status ;;
    ui|open)        open_ui ;;
    logs|log)       show_logs ;;
    enter|bash|sh)  enter_container "$@" ;;
    help|-h|--help) show_help ;;
    *)
        echo -e "${RED}알 수 없는 명령: '$cmd'${NC}"
        show_help
        exit 1
        ;;
esac
